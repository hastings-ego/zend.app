
    <!-- MAIN CONTENT - FORGOT PASSWORD PORTAL -->
    <main class="flex-grow pt-32 pb-20 max-w-xl mx-auto px-6 w-full reveal flex flex-col justify-center">
        
        <!-- HEADER -->
        <div class="mb-12 text-center">
            <p class="text-[10px] font-bold uppercase tracking-[0.5em] opacity-40 mb-4"></p>
            <h1 class="font-display font-black text-4xl md:text-5xl uppercase">
                Reset Password
            </h1>
            <p class="text-xs uppercase tracking-widest opacity-60 mt-3">Provide your email address to reset your password</p>
        </div>

        <!-- RECOVERY BOX -->
        <div class="border specimen-border p-8 md:p-12 bg-white/40 shadow-sm relative">
        

            <!-- RECOVERY FORM -->
            <form id="recovery-form" class="space-y-8">
                <div class="space-y-3">
                    <label class="block text-[15px] font-bold uppercase opacity-60">Email</label>
                    <input type="email" id="recovery-email" placeholder="" required class="w-full bg-transparent border specimen-border p-4 text-xs font-mono uppercase focus:border-archive-ink outline-none placeholder:opacity-30">
                </div>

                <button type="submit" id="recovery-submit-btn" class="w-full bg-archive-ink text-archive-paper py-5 text-xs font-bold uppercase hover:opacity-90 transition-opacity">
                    RESET ACCOUNT
                </button>

                <div class="text-center pt-2">
                    <a href="<!-- #!/engine/node/ page('login'); -->" class="text-[15px] uppercase opacity-50 hover:opacity-100 transition-opacity">
                        Login Account
                    </a>
                </div>
            </form>

            <!-- SUCCESS STATE DISPLAY (Hidden by default) -->
            <div id="recovery-success-state" class="hidden text-center py-10 space-y-6">
                <p class="text-[10px] font-bold uppercase tracking-[0.4em] text-emerald-700">Packet Dispatched [+]</p>
                <h3 class="font-display font-black text-2xl uppercase italic">Check Coordinates</h3>
                <p class="text-xs uppercase tracking-widest opacity-60">If an operative node matches the provided identifier, instructions for encryption key reset have been transmitted.</p>
                <div class="pt-4">
                    <a href="<!-- #!/engine/node/ page('login'); -->" class="inline-block border specimen-border px-8 py-4 text-[10px] font-bold uppercase tracking-[0.4em] hover:bg-archive-ink hover:text-archive-paper transition-all">
                        RETURN_TO_LOGIN
                    </a>
                </div>
            </div>

        </div>

    </main>

    <!-- RECOVERY LOGIC -->
    <script>
        class RecoveryController {
            constructor() {
                this.initFormSubmit();
                this.initMobileMenu();
                this.updateCartCount();
            }

            initFormSubmit() {
                const form = document.getElementById('recovery-form');
                const btn = document.getElementById('recovery-submit-btn');
                const successState = document.getElementById('recovery-success-state');

                form.addEventListener('submit', (e) => {
                    e.preventDefault();

                    btn.textContent = 'DISPATCHING PACKET...';
                    btn.classList.add('bg-emerald-900');

                    setTimeout(() => {
                        form.classList.add('hidden');
                        successState.classList.remove('hidden');
                    }, 1200);
                });
            }

            initMobileMenu() {
                const btn = document.getElementById('menu-toggle');
                const menu = document.getElementById('mobile-menu');
                let isOpen = false;

                btn.addEventListener('click', () => {
                    isOpen = !isOpen;
                    if (isOpen) {
                        menu.classList.remove('menu-closed');
                        menu.classList.add('menu-open');
                        btn.textContent = '[ CLOSE ]';
                    } else {
                        menu.classList.remove('menu-open');
                        menu.classList.add('menu-closed');
                        btn.textContent = '[ MENU ]';
                    }
                });
            }

            updateCartCount() {
                const cart = JSON.parse(localStorage.getItem('specimen_cart')) || [];
                const count = cart.reduce((acc, item) => acc + item.qty, 0);
                document.querySelectorAll('.js-cart-count').forEach(el => el.textContent = count);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            window.RecoveryApp = new RecoveryController();
        });
    </script>
