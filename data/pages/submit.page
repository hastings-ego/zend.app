<main class="policy-section">
    <div class="container" style="max-width: 800px; padding-top: 2rem; padding-bottom: 4rem;">
        
        <!-- Confirmation Card -->
        <div class="card-machined policy-card" style="padding: 3rem 2rem; text-align: center; position: relative; overflow: hidden; margin-bottom: 2rem;">
            
            <!-- Technical Status Indicator -->
            <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(34, 197, 94, 0.1); border: 1px solid #22c55e; border-radius: var(--radius-sm); padding: 0.375rem 0.875rem; margin-bottom: 1.5rem;">
                <span style="width: 8px; height: 8px; border-radius: 50%; background: #22c55e; display: inline-block; box-shadow: 0 0 8px #22c55e;"></span>
                <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: #22c55e;">
                    TRANSMISSION SUCCESSFUL
                </span>
            </div>

            <!-- Header Title -->
            <h1 class="policy-title" style="font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; margin-bottom: 1rem;">
                INQUIRY LOGGED TO STUDIO QUEUE
            </h1>
            
            <p class="policy-text" style="font-size: 1.0625rem; max-width: 580px; margin: 0 auto 2rem auto;">
                Thank you for contacting DROPSTUDIO. Your message has been received by our studio collective and dispatched to the appropriate department.
            </p>

            <!-- Ticket & Telemetry Details Card -->
            <div style="background: var(--bg-card-subtle); border: 1px solid var(--border-medium); border-radius: var(--radius-sm); padding: 1.5rem; text-align: left; max-width: 520px; margin: 0 auto 2.5rem auto;">
                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem; margin-bottom: 0.75rem;">
                    <span style="font-size: 0.75rem; font-weight: 700; color: var(--text-subtle); text-transform: uppercase;">Ticket Reference</span>
                    <span style="font-size: 0.875rem; font-weight: 800; font-family: monospace; color: var(--text-main);">#DS-9042-INQ</span>
                </div>
                
                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem; margin-bottom: 0.75rem;">
                    <span style="font-size: 0.75rem; font-weight: 700; color: var(--text-subtle); text-transform: uppercase;">Target Department</span>
                    <span style="font-size: 0.8125rem; font-weight: 700; color: var(--text-main);">General Studio / Orders</span>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem; margin-bottom: 0.75rem;">
                    <span style="font-size: 0.75rem; font-weight: 700; color: var(--text-subtle); text-transform: uppercase;">Guaranteed SLA</span>
                    <span style="font-size: 0.8125rem; font-weight: 700; color: var(--text-main);">&lt; 24 Hours Response</span>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-size: 0.75rem; font-weight: 700; color: var(--text-subtle); text-transform: uppercase;">Status</span>
                    <span style="font-size: 0.8125rem; font-weight: 700; color: #eab308; display: flex; align-items: center; gap: 0.35rem;">
                        <i data-lucide="clock" size="14"></i> Awaiting Team Review
                    </span>
                </div>
            </div>

            <!-- Primary Action Buttons -->
            <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                <a href="#" class="btn btn-acid" style="padding: 0.875rem 1.5rem; font-size: 0.875rem;">
                    <i data-lucide="shopping-bag" size="16"></i> Return to Active Drop
                </a>
                <a href="#" class="btn btn-outline" style="padding: 0.875rem 1.5rem; font-size: 0.875rem;">
                    <i data-lucide="home" size="16"></i> Return Home
                </a>
            </div>

        </div>

        <!-- Workflow Next Steps Section -->
        <div class="card-machined policy-card" style="padding: 2rem;">
            <h2 class="section-heading" style="margin-bottom: 1.5rem; font-size: 1.125rem;">
                <i data-lucide="git-commit" size="20"></i> What Happens Next?
            </h2>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;">
                
                <!-- Step 1 -->
                <div style="position: relative;">
                    <div style="font-size: 0.75rem; font-weight: 800; color: var(--text-subtle); text-transform: uppercase; margin-bottom: 0.5rem;">
                        Step 01
                    </div>
                    <h3 style="font-size: 0.9375rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.375rem;">
                        Automated Confirmation
                    </h3>
                    <p class="policy-text" style="font-size: 0.8125rem; margin-bottom: 0;">
                        A confirmation email containing your inquiry receipt copy has been sent to your inbox.
                    </p>
                </div>

                <!-- Step 2 -->
                <div style="position: relative;">
                    <div style="font-size: 0.75rem; font-weight: 800; color: var(--text-subtle); text-transform: uppercase; margin-bottom: 0.5rem;">
                        Step 02
                    </div>
                    <h3 style="font-size: 0.9375rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.375rem;">
                        Human Review
                    </h3>
                    <p class="policy-text" style="font-size: 0.8125rem; margin-bottom: 0;">
                        A studio representative analyzes your inquiry, order status, or technical specification request.
                    </p>
                </div>

                <!-- Step 3 -->
                <div style="position: relative;">
                    <div style="font-size: 0.75rem; font-weight: 800; color: var(--text-subtle); text-transform: uppercase; margin-bottom: 0.5rem;">
                        Step 03
                    </div>
                    <h3 style="font-size: 0.9375rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.375rem;">
                        Direct Resolution
                    </h3>
                    <p class="policy-text" style="font-size: 0.8125rem; margin-bottom: 0;">
                        You will receive a direct reply from our team with actionable assistance within 24 business hours.
                    </p>
                </div>

            </div>
        </div>

        <!-- Support Policy Quick Reference -->
        <div style="margin-top: 2rem; text-align: center;">
            <p class="policy-text" style="font-size: 0.8125rem; color: var(--text-subtle);">
                Need immediate help with an active order dispatch? View our <a href="#" style="color: var(--text-main); font-weight: 700; text-decoration: underline;">Shipping & Dispatch Policy</a> or <a href="#" style="color: var(--text-main); font-weight: 700; text-decoration: underline;">Return Protocol</a>.
            </p>
        </div>

    </div>
</main>