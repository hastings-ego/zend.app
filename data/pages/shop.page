
    <style>
        
        /* Architecture lines */
        .specimen-border { border: 0.5px solid #E0E0E0; }
        .dark-border { border: 0.5px solid rgba(245, 245, 245, 0.2); }
        
        /* Subtle reveal animations */
        .reveal { animation: specReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        @keyframes specReveal { 
            from { opacity: 0; transform: translateY(20px); filter: blur(5px); } 
            to { opacity: 1; transform: translateY(0); filter: blur(0); } 
        }

        /* Card Hover Effects */
        .specimen-card img { transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
        .specimen-card:hover img { transform: scale(1.03); }

        /* Filter Active States */
        .filter-active { background-color: #1A1A1A !important; color: #F5F5F5 !important; border-color: #1A1A1A !important; }

        /* Mobile Menu Transitions */
        #mobile-menu { transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
        .menu-open { transform: translateY(0%); }
        .menu-closed { transform: translateY(-100%); }

        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-thumb { background: #1A1A1A; }
    </style>



    <!-- MAIN CONTENT - CATALOG MATRIX -->
    <main class="flex-grow pt-32 pb-20 max-w-7xl mx-auto px-6 md:px-10 w-full reveal">
        
        <!-- HEADER & CATALOG TELEMETRY -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 pb-8 border-b specimen-border gap-6">
            <div>
                <p class="text-[10px] font-bold uppercase opacity-40 mb-4">View Whats In Store</p>
                <h1 class="font-display font-black text-4xl md:text-6xl uppercase tracking-tighter">
                    Our Shop
                </h1>
            </div>
            <div class="text-right">
                <p id="artifact-count" class="text-xs uppercase tracking-widest font-bold">Total Products: [ 9 ]</p>
            </div>
        </div>

        <!-- FILTER CONTROLS -->
        <div class="flex flex-wrap gap-3 mb-16" id="category-filters">
            <button class="filter-btn border specimen-border px-6 py-3 text-[10px] font-bold uppercase tracking-[0.3em] filter-active transition-all" data-category="ALL">All Classifications</button>
            <button class="filter-btn border specimen-border px-6 py-3 text-[10px] font-bold uppercase tracking-[0.3em] hover:border-archive-ink transition-all" data-category="Apparel">Apparel</button>
            <button class="filter-btn border specimen-border px-6 py-3 text-[10px] font-bold uppercase tracking-[0.3em] hover:border-archive-ink transition-all" data-category="Outerwear">Outerwear</button>
            <button class="filter-btn border specimen-border px-6 py-3 text-[10px] font-bold uppercase tracking-[0.3em] hover:border-archive-ink transition-all" data-category="Hardware">Hardware</button>
        </div>

        <!-- PRODUCT GRID -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12" id="catalog-grid">
            <!-- Populated via JS -->
        </div>

    </main>

    <!-- PRODUCT CARD TEMPLATE -->
    <template id="tpl-catalog-card">
        <a href="<!-- #!/engine/node/ page(''); -->" class="specimen-card flex flex-col group cursor-pointer block">
            <div class="aspect-[4/5] bg-archive-line mb-6 overflow-hidden relative specimen-border">
                <img src="" alt="" class="w-full h-full object-cover grayscale js-card-img">
                <div class="absolute inset-0 bg-archive-paper/80 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                    <span class="text-[15px] font-bold">VIEW PRODUCT</span>
                </div>
            </div>
            <div class="flex justify-between items-start">
                <div>
                    <h3 class="font-display font-black text-xl uppercase js-card-title"></h3>
                    <p class="text-[9px] opacity-40 uppercase js-card-category mt-1"></p>
                </div>
                <span class="font-bold text-sm js-card-price"></span>
            </div>
        </a>
    </template>

    <!-- CATALOG LOGIC -->
    <script>
        <!-- #!/engine/node/
        app()->create_shop_ui(api()->async_products());
        -->
        

        class CatalogController {
            constructor() {
                this.currentCategory = 'ALL';
                this.renderGrid(DB_PRODUCTS);
                this.initFilters();
                this.initMobileMenu();
                this.updateCartCount();
            }

            renderGrid(products) {
                const grid = document.getElementById('catalog-grid');
                const template = document.getElementById('tpl-catalog-card');
                grid.innerHTML = '';

                products.forEach(p => {
                    const clone = template.content.cloneNode(true);
                    
                    const link = clone.querySelector('a');
                    link.href = `<!-- #!/engine/node/ page('product','${p.id}'); -->`;

                    clone.querySelector('.js-card-title').textContent = p.title;
                    clone.querySelector('.js-card-category').textContent = p.category;
                    clone.querySelector('.js-card-price').textContent = `R ${p.price.toFixed(2)}`;
                    
                    const img = clone.querySelector('.js-card-img');
                    img.src = p.gallery[0];
                    img.alt = p.title;

                    grid.appendChild(clone);
                });

                document.getElementById('artifact-count').textContent = `Total Products: [ ${products.length} ]`;
            }

            initFilters() {
                const buttons = document.querySelectorAll('.filter-btn');
                buttons.forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        buttons.forEach(b => {
                            b.classList.remove('filter-active');
                            b.classList.add('border', 'specimen-border');
                        });
                        e.target.classList.add('filter-active');
                        e.target.classList.remove('border', 'specimen-border');

                        const category = e.target.getAttribute('data-category');
                        this.currentCategory = category;

                        if (category === 'ALL') {
                            this.renderGrid(DB_PRODUCTS);
                        } else {
                            const filtered = DB_PRODUCTS.filter(p => p.category === category);
                            this.renderGrid(filtered);
                        }
                    });
                });
            }

            initMobileMenu() {
                const btn = document.getElementById('menu-toggle');
                const menu = document.getElementById('mobile-menu');
                let isOpen = false;

                btn.addEventListener('click', () => {
                    isOpen = !isOpen;
                    if (isOpen) {
                        menu.classList.remove('menu-closed');
                        menu.classList.add('menu-open');
                        btn.textContent = '[ CLOSE ]';
                    } else {
                        menu.classList.remove('menu-open');
                        menu.classList.add('menu-closed');
                        btn.textContent = '[ MENU ]';
                    }
                });
            }

            updateCartCount() {
                const cart = JSON.parse(localStorage.getItem('specimen_cart')) || [];
                const count = cart.reduce((acc, item) => acc + item.qty, 0);
                document.querySelectorAll('.js-cart-count').forEach(el => el.textContent = count);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            window.CatalogApp = new CatalogController();
        });
    </script>