                    </div>
                    <h3 style="font-size: 1.0625rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.5rem;">
                        DS-05 Archival Graphic Crewneck
                    </h3>
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--border-light);">
                        <span style="font-size: 1.125rem; font-weight: 800; color: var(--text-muted);">$110</span>
                        <button class="btn btn-outline" disabled style="padding: 0.5rem 0.875rem; font-size: 0.75rem; cursor: not-allowed; opacity: 0.6;">
                            Archived
                        </button>
                    </div>
                </div>

                <!-- Product Card 6 -->
                <div class="card-machined policy-card" style="padding: 1.25rem;">
                    <div style="border-radius: var(--radius-sm); overflow: hidden; margin-bottom: 1rem; border: 1px solid var(--border-light); position: relative;">
                        <img src="https://images.unsplash.com/photo-1620799140408-edc6dcb6d633?auto=format&fit=crop&w=600&q=80" alt="Structured Thermal Longsleeve" style="width: 100%; aspect-ratio: 4/5; object-fit: cover; display: block;">
                    </div>
                    <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-subtle); margin-bottom: 0.25rem;">
