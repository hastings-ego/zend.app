<main class="policy-section">
    <div class="container">
        
        <!-- Page Header -->
        <div class="policy-header" style="max-width: 760px; margin-bottom: 2.5rem;">
            <h1 class="policy-title">Active Drops</h1>
            <p class="policy-meta">Drop Archive & Limited Inventory — Heavyweight garments engineered for daily wear.</p>
        </div>

        <div class="policy-grid">
            
            <!-- Filters & Category Navigation Sidebar -->
            <aside class="card-machined policy-sidebar">
                <div class="sidebar-title">Categories</div>
                <ul class="sidebar-nav" style="margin-bottom: 1.5rem;">
                    <li><a href="#" class="sidebar-link" style="background-color: var(--bg-card-subtle); color: var(--text-main);">All Drops (8)</a></li>
                    <li><a href="#" class="sidebar-link">Outerwear & Fleece (3)</a></li>
                    <li><a href="#" class="sidebar-link">Tees & Tops (3)</a></li>
                    <li><a href="#" class="sidebar-link">Pants & Bottoms (2)</a></li>
                </ul>

                <div class="sidebar-title">Filter By Size</div>
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
                    <button class="btn btn-outline" style="padding: 0.375rem 0.75rem; font-size: 0.75rem;">S</button>
                    <button class="btn btn-acid" style="padding: 0.375rem 0.75rem; font-size: 0.75rem;">M</button>
                    <button class="btn btn-outline" style="padding: 0.375rem 0.75rem; font-size: 0.75rem;">L</button>
                    <button class="btn btn-outline" style="padding: 0.375rem 0.75rem; font-size: 0.75rem;">XL</button>
                </div>

                <div class="sidebar-title">Availability</div>
                <ul class="sidebar-nav">
                    <li><a href="#" class="sidebar-link">In Stock Only</a></li>
                    <li><a href="#" class="sidebar-link">Archived Releases</a></li>
                </ul>
            </aside>

            <!-- Main Product Catalog Grid -->
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem; align-items: start;">
                
                <!-- Product Card 1 -->
                <div class="card-machined policy-card" style="padding: 1.25rem;">
                    <div style="border-radius: var(--radius-sm); overflow: hidden; margin-bottom: 1rem; border: 1px solid var(--border-light); position: relative;">
                        <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?auto=format&fit=crop&w=600&q=80" alt="Heavyweight Boxy Hoodie" style="width: 100%; aspect-ratio: 4/5; object-fit: cover; display: block;">
                        <div style="position: absolute; top: 0.75rem; right: 0.75rem; background: var(--bg-card); border: 1px solid var(--border-medium); border-radius: var(--radius-sm); padding: 0.25rem 0.5rem; font-size: 0.75rem; font-weight: 700;">
                            500 GSM
                        </div>
                    </div>
                    <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-subtle); margin-bottom: 0.25rem;">
                        Outerwear
                    </div>
                    <h3 style="font-size: 1.0625rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.5rem;">
                        DS-01 Boxy French Terry Hoodie
                    </h3>
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--border-light);">
                        <span style="font-size: 1.125rem; font-weight: 800; color: var(--text-main);">$140</span>
                        <a href="#" class="btn btn-acid" style="padding: 0.5rem 0.875rem; font-size: 0.75rem;">
                            <i data-lucide="shopping-bag" size="14"></i> Add to Cart
                        </a>
                    </div>
                </div>

                <!-- Product Card 2 -->
                <div class="card-machined policy-card" style="padding: 1.25rem;">
                    <div style="border-radius: var(--radius-sm); overflow: hidden; margin-bottom: 1rem; border: 1px solid var(--border-light); position: relative;">
                        <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=600&q=80" alt="Oversized Heavyweight Tee" style="width: 100%; aspect-ratio: 4/5; object-fit: cover; display: block;">
                        <div style="position: absolute; top: 0.75rem; right: 0.75rem; background: var(--bg-card); border: 1px solid var(--border-medium); border-radius: var(--radius-sm); padding: 0.25rem 0.5rem; font-size: 0.75rem; font-weight: 700;">
                            320 GSM
                        </div>
                    </div>
                    <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-subtle); margin-bottom: 0.25rem;">
                        Tees & Tops
                    </div>
                    <h3 style="font-size: 1.0625rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.5rem;">
                        DS-04 Heavyweight Raw Edge Tee
                    </h3>
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--border-light);">
                        <span style="font-size: 1.125rem; font-weight: 800; color: var(--text-main);">$65</span>
                        <a href="#" class="btn btn-acid" style="padding: 0.5rem 0.875rem; font-size: 0.75rem;">
                            <i data-lucide="shopping-bag" size="14"></i> Add to Cart
                        </a>
                    </div>
                </div>

                <!-- Product Card 3 -->
                <div class="card-machined policy-card" style="padding: 1.25rem;">
                    <div style="border-radius: var(--radius-sm); overflow: hidden; margin-bottom: 1rem; border: 1px solid var(--border-light); position: relative;">
                        <img src="https://images.unsplash.com/photo-1541099649105-f69ad21f3246?auto=format&fit=crop&w=600&q=80" alt="Tactile Cargo Trouser" style="width: 100%; aspect-ratio: 4/5; object-fit: cover; display: block;">
                    </div>
                    <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-subtle); margin-bottom: 0.25rem;">
                        Bottoms
                    </div>
                    <h3 style="font-size: 1.0625rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.5rem;">
                        DS-08 Modular Double-Knee Cargo
                    </h3>
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid var(--border-light);">
                        <span style="font-size: 1.125rem; font-weight: 800; color: var(--text-main);">$160</span>
                        <a href="#" class="btn btn-acid" style="padding: 0.5rem 0.875rem; font-size: 0.75rem;">
                            <i data-lucide="shopping-bag" size="14"></i> Add to Cart
                        </a>
                    </div>
                </div>

                <!-- Product Card 4 -->
                <div class="card-machined policy-card" style="padding: 1.25rem;">
                    <div style="border-radius: var(--radius-sm); overflow: hidden; margin-bottom: 1rem; border: 1px solid var(--border-light); position: relative;">
                        <img src="https://images.unsplash.com/photo-1578587018452-892bacefd3f2?auto=format&fit=crop&w=600&q=80" alt="Industrial Zip Jacket" style="width: 100%; aspect-ratio: 4/5; object-fit: cover; display: block;">
                    </div>
                    <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-subtle); margin-bottom: 0.25rem;">
