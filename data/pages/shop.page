                    </div>
                </div>

                <!-- Product Card 5 (Sold Out State) -->
                <div class="card-machined policy-card" style="padding: 1.25rem; opacity: 0.75;">
                    <div style="border-radius: var(--radius-sm); overflow: hidden; margin-bottom: 1rem; border: 1px solid var(--border-light); position: relative;">
                        <img src="https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?auto=format&fit=crop&w=600&q=80" alt="Graphic Crewneck" style="width: 100%; aspect-ratio: 4/5; object-fit: cover; display: block; filter: grayscale(100%);">
                        <div style="position: absolute; top: 0.75rem; left: 0.75rem; background: var(--text-main); color: var(--bg-card); border-radius: var(--radius-sm); padding: 0.25rem 0.5rem; font-size: 0.75rem; font-weight: 700;">
                            SOLD OUT
