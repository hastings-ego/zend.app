
    <style>
        
        /* Architecture lines */
        .specimen-border { border: 0.5px solid #E0E0E0; }
        .dark-border { border: 0.5px solid rgba(245, 245, 245, 0.2); }
        
        /* Subtle reveal animations */
        .reveal { animation: specReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        @keyframes specReveal { 
            from { opacity: 0; transform: translateY(20px); filter: blur(5px); } 
            to { opacity: 1; transform: translateY(0); filter: blur(0); } 
        }

        /* Mobile Menu Transitions */
        #mobile-menu { transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
        .menu-open { transform: translateY(0%); }
        .menu-closed { transform: translateY(-100%); }

        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-thumb { background: #1A1A1A; }
    </style>

    <!-- MAIN CONTENT - SIGN UP PORTAL -->
    <main class="flex-grow pt-32 pb-20 max-w-xl mx-auto px-6 w-full reveal flex flex-col justify-center">
        
        <!-- HEADER -->
        <div class="mb-12 text-center">
            <p class="text-[10px] font-bold uppercase tracking-[0.5em] opacity-40 mb-4"></p>
            <h1 class="font-display font-black text-4xl md:text-5xl uppercase tracking-tighter">
                Register New Account
            </h1>
        </div>

        <!-- SIGNUP BOX -->
        <div class="border specimen-border p-8 md:p-12 bg-white/40 shadow-sm relative">
            
            <!-- SIGNUP FORM -->
            <form id="signup-form" class="space-y-8">
                
                <div class="space-y-3">
                    <label class="block text-[10px] font-bold uppercase opacity-60">Your Name</label>
                    <input type="text" id="signup-name" placeholder="FULL NAME" required class="w-full bg-transparent border specimen-border p-4 text-xs font-mono uppercase focus:border-archive-ink outline-none placeholder:opacity-30">
                </div>

                <div class="space-y-3">
                    <label class="block text-[10px] font-bold uppercase opacity-60">Email</label>
                    <input type="email" id="signup-email" placeholder="" required class="w-full bg-transparent border specimen-border p-4 text-xs font-mono uppercase focus:border-archive-ink outline-none placeholder:opacity-30">
                </div>

                <div class="space-y-3">
                    <label class="block text-[10px] font-bold uppercase opacity-60">Password</label>
                    <input type="password" id="signup-password" placeholder="••••••••••••" required class="w-full bg-transparent border specimen-border p-4 text-xs font-mono uppercase focus:border-archive-ink outline-none placeholder:opacity-30">
                </div>

                <div class="flex items-center space-x-3 text-[10px] uppercase opacity-75">
                    <input type="checkbox" id="terms-check" required class="accent-archive-ink w-4 h-4">
                    <label for="terms-check">I agree to the <a href="<!-- #!/engine/node/ page('terms-of-use'); --> class="underline hover:opacity-100">Terms of Void</a> & Data Policy.</label>
                </div>

                <button type="submit" id="signup-submit-btn" class="w-full bg-archive-ink text-archive-paper py-5 text-xs font-bold uppercase hover:opacity-90 transition-opacity">
                    REGISTER ACCOUNT
                </button>
            </form>

            <!-- SUCCESS STATE DISPLAY (Hidden by default) -->
            <div id="signup-success-state" class="hidden text-center py-10 space-y-6">
                <p class="text-[10px] font-bold uppercase tracking-[0.4em] text-emerald-700">Node Registered [+]</p>
                <h3 class="font-display font-black text-2xl uppercase italic">Credentials Confirmed</h3>
                <p class="text-xs uppercase tracking-widest opacity-60">Initial setup complete. Routing you to the catalog...</p>
            </div>

        </div>

    </main>


    <!-- SIGNUP LOGIC -->
    <script>
        class SignupController {
            constructor() {
                this.initFormSubmit();
                this.initMobileMenu();
                this.updateCartCount();
            }

            initFormSubmit() {
                const form = document.getElementById('signup-form');
                const btn = document.getElementById('signup-submit-btn');
                const successState = document.getElementById('signup-success-state');

                form.addEventListener('submit', (e) => {
                    e.preventDefault();

                    btn.textContent = 'INITIALIZING NEW NODE...';
                    btn.classList.add('bg-emerald-900');

                    setTimeout(() => {
                        form.classList.add('hidden');
                        successState.classList.remove('hidden');

                        // Save mock registered session state
                        localStorage.setItem('specimen_session', JSON.stringify({
                            active: true,
                            name: document.getElementById('signup-name').value,
                            email: document.getElementById('signup-email').value,
                            timestamp: new Date().toISOString()
                        }));

                        setTimeout(() => {
                            window.location.href = '<!-- #!/engine/node/ page(\'shop\'); -->';
                        }, 1500);
                    }, 1200);
                });
            }

            initMobileMenu() {
                const btn = document.getElementById('menu-toggle');
                const menu = document.getElementById('mobile-menu');
                let isOpen = false;

                btn.addEventListener('click', () => {
                    isOpen = !isOpen;
                    if (isOpen) {
                        menu.classList.remove('menu-closed');
                        menu.classList.add('menu-open');
                        btn.textContent = '[ CLOSE ]';
                    } else {
                        menu.classList.remove('menu-open');
                        menu.classList.add('menu-closed');
                        btn.textContent = '[ MENU ]';
                    }
                });
            }

            updateCartCount() {
                const cart = JSON.parse(localStorage.getItem('specimen_cart')) || [];
                const count = cart.reduce((acc, item) => acc + item.qty, 0);
                document.querySelectorAll('.js-cart-count').forEach(el => el.textContent = count);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            window.SignupApp = new SignupController();
        });
    </script>
