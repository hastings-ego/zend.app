            <div>
                <p class="font-bold uppercase opacity-40 mb-4">Feel Free To Contact Us</p>
                <h1 class="font-display font-black text-4xl md:text-6xl uppercase tracking-tighter">
                    Contact Us
                </h1>
            </div>
        </div>

        <!-- CONTACT GRID LAYOUT -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
            
            <!-- TRANSMISSION FORM (Left 7 Columns) -->
            <div class="lg:col-span-7 border specimen-border p-8 md:p-12 bg-white/40">
                <div class="mb-10 pb-6 border-b specimen-border">
                    <h2 class="font-display font-black text-2xl uppercase tracking-tight">Here To Support </h2>
                    <p class="text-[10px] uppercase opacity-40 mt-2">Please fill in the information and we will get back to you.</p>
                </div>

                <form name="contact-form" action="/forms.php" method="POST" id="contact-form" class="space-y-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-3">
                            <label class="block text-[10px] font-bold uppercase tracking-[0.3em] opacity-60">Name</label>
                            <input type="text" name="name" id="contact-name" placeholder="FULL NAME" required class="w-full bg-transparent border specimen-border p-4 text-xs font-mono uppercase focus:border-archive-ink outline-none placeholder:opacity-30">
                        </div>
                        <div class="space-y-3">
                            <label class="block text-[10px] font-bold uppercase tracking-[0.3em] opacity-60">Email</label>
                            <input type="email" name="email" id="contact-email" placeholder="EMAIL ADDRESS" required class="w-full bg-transparent border specimen-border p-4 text-xs font-mono uppercase focus:border-archive-ink outline-none placeholder:opacity-30">
                        </div>
